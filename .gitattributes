# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Executable scripts
gradlew text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
*.aar binary
*.so binary
*.jks binary
*.keystore binary
